# ===== DEPLOYER WALLET =====
# NEVER commit the real .env. Generate a fresh wallet for testnet (cast wallet new).
DEPLOYER_PRIVATE_KEY=replace-with-your-testnet-private-key
DEPLOYER_ADDRESS=replace-with-your-testnet-address

# ===== CREDITCOIN / ATTESTCOIN TESTNET =====
# Creditcoin CC3 testnet RPC (official)
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
# Creditcoin EVM chain id (queried live: 0x18e8f)
CREDITCOIN_CHAIN_ID=102031
# Attestcoin proof builder URL (official)
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network

# ===== SOURCE CHAIN (Sepolia) =====
# Source chain key for Sepolia on CC3 Testnet (official examples: SOURCE_CHAIN_KEY=1)
SOURCE_CHAIN_KEY=1
# Sepolia RPC — free public endpoint (publicnode is free; drpc.org now requires paid plan)
SOURCE_CHAIN_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ===== CONTRACTS (fill after deployment) =====
SERVICE_REGISTRY_ADDRESS=
SLA_SETTLEMENT_ADDRESS=
