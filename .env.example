# ===== CREDITCOIN / ATTESTCOIN TESTNET =====
# Creditcoin testnet RPC (confirm exact URL at implementation time)
CC3_TESTNET_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
# Creditcoin EVM chain id (confirm)
CC3_TESTNET_CHAIN_ID=102033

# Attestcoin proof builder service
ATTESTCOIN_PROVER_URL=https://prover.cc3-testnet.creditcoin.network

# ===== SOURCE CHAIN (e.g. Sepolia) =====
SEPOLIA_RPC_URL=https://sepolia.drpc.org
# The chainKey Attestcoin uses for this source chain (confirm at implementation time)
SOURCE_CHAIN_KEY=

# ===== DEPLOYER WALLET =====
# NEVER commit the real .env. Generate a fresh wallet for testnet.
DEPLOYER_PRIVATE_KEY=replace-with-your-testnet-private-key

# ===== CONTRACTS (fill after deployment) =====
SERVICE_REGISTRY_ADDRESS=
SLA_SETTLEMENT_ADDRESS=
